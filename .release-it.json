{
  "git": {
    "changelog": null,
    "commit": true,
    "commitMessage": ":bookmark: Release ${version}",
    "commitArgs": [],
    "tag": true,
    "tagName": null,
    "tagMatch": null,
    "tagAnnotation": "Release ${version}",
    "requireBranch": ["main", "hotfix/*"],
    "pushArgs": [],
    "releaseNotes": null
  },
  "github": {
    "release": false,
    "releaseName": "Release ${version}",
    "preRelease": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        "takopic.php"
      ]
    }
  },
  "hooks": {
    "before:init": [
      "bash tools/release/check-ci.sh",
      "bash tools/release/check-notes.sh",
      "bash tools/release/check-wordpress.sh"
    ],
    "after:release": "git push origin ${version}",
    "after:bump": [
      "perl -pi -e 's/^Stable tag:.*/Stable tag: ${version}/' readme.txt",
      "perl -pi -e \"s/^## Unreleased\\$/## Unreleased\\n\\n## ${version} – $(date +%F)/\" CHANGELOG.md",
      "bash tools/release/sync-changelog.sh"
    ]
  }
}
