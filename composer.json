{
    "name": "striffly/takopic",
    "description": "Takopic: compresses JPG and PNG images and converts them to WebP and AVIF on your own server.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Clément Gayot",
            "homepage": "https://github.com/Striffly"
        }
    ],
    "require": {
        "php": ">=7.4",
        "deliciousbrains/wp-background-processing": "^1.4"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Takopic\\Vendor\\",
            "classmap_prefix": "Takopic_Vendor_",
            "packages": [
                "deliciousbrains/wp-background-processing"
            ],
            "delete_vendor_packages": true
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "strauss",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    },
    "require-dev": {
        "brianhenryie/strauss": "^0.31.1"
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
