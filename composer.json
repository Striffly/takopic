{
    "name": "striffly/takopic",
    "description": "Takopic: compresses JPG and PNG images and converts them to WebP and AVIF on your own server.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Clément Gayot",
            "homepage": "https://github.com/Striffly"
        }
    ],
    "require": {
        "php": ">=8.2",
        "deliciousbrains/wp-background-processing": "^1.4"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Takopic\\Vendor\\",
            "classmap_prefix": "Takopic_Vendor_",
            "packages": [
                "deliciousbrains/wp-background-processing"
            ],
            "delete_vendor_packages": true
        },
        "patches": {
            "deliciousbrains/wp-background-processing": [
                {
                    "description": "Let the cron of WordPress go on while a job runs (pull request 144 of the library)",
                    "url": "patches/wp-background-processing-cron-healthcheck.patch"
                }
            ]
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "strauss",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ],
        "test": "phpunit",
        "test:multisite": [
            "@putenv WP_MULTISITE=1",
            "phpunit"
        ],
        "lint": "phpcs"
    },
    "require-dev": {
        "brianhenryie/strauss": "^0.31.1",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0",
        "wp-phpunit/wp-phpunit": "^7.1",
        "roots/wordpress-no-content": "^7.1",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "cweagans/composer-patches": "^2"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true
        }
    }
}
